{
	"info": {
		"_postman_id": "api-tests-jsonplaceholder",
		"name": "JSONPlaceholder API Tests",
		"description": "Testes automatizados para API JSONPlaceholder - Parte 2",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Teste GET - Comments",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// ========================================",
							"// Funcionalidade: Consultar comentários da API",
							"// Cenário: Buscar todos os comentários com sucesso",
							"// ========================================",
							"",
							"// Dado: A API está disponível",
							"// Quando: Faço uma requisição GET para /comments",
							"",
							"// Então: A resposta deve ser bem-sucedida",
							"pm.test(\"✓ Então: Status code deve ser 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"✓ E: Resposta deve ser um array\", function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});",
							"",
							"pm.test(\"✓ E: Array deve conter elementos\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.length).to.be.above(0);",
							"});",
							"",
							"// E: Os comentários devem ter estrutura válida",
							"pm.test(\"✓ E: Cada comentário deve ter campos obrigatórios (postId, id, name, email, body)\", function () {",
							"    const comment = pm.response.json()[0];",
							"    pm.expect(comment).to.have.property('postId');",
							"    pm.expect(comment).to.have.property('id');",
							"    pm.expect(comment).to.have.property('name');",
							"    pm.expect(comment).to.have.property('email');",
							"    pm.expect(comment).to.have.property('body');",
							"});",
							"",
							"pm.test(\"✓ E: Campos devem ter tipos de dados corretos\", function () {",
							"    const comment = pm.response.json()[0];",
							"    pm.expect(comment.postId).to.be.a('number');",
							"    pm.expect(comment.id).to.be.a('number');",
							"    pm.expect(comment.name).to.be.a('string');",
							"    pm.expect(comment.email).to.be.a('string');",
							"    pm.expect(comment.body).to.be.a('string');",
							"});",
							"",
							"pm.test(\"✓ E: Email deve ter formato válido\", function () {",
							"    const comment = pm.response.json()[0];",
							"    pm.expect(comment.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://jsonplaceholder.typicode.com/comments",
					"protocol": "https",
					"host": [
						"jsonplaceholder",
						"typicode",
						"com"
					],
					"path": [
						"comments"
					]
				},
				"description": "Teste do método GET para validar a resposta do servidor e o status code."
			},
			"response": []
		},
		{
			"name": "Teste POST - Albums",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// ========================================",
							"// Funcionalidade: Criar novo álbum na API",
							"// Cenário: Criar álbum com dados válidos",
							"// ========================================",
							"",
							"// Dado: Tenho dados válidos de um álbum (userId: 1, title: 'Nova ID')",
							"// Quando: Envio uma requisição POST para /albums",
							"",
							"// Então: O álbum deve ser criado com sucesso",
							"pm.test(\"✓ Então: Status code deve ser 201 (Created)\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"✓ E: Resposta deve ser um objeto JSON\", function () {",
							"    pm.expect(pm.response.json()).to.be.an('object');",
							"});",
							"",
							"pm.test(\"✓ E: Tempo de resposta deve estar abaixo de 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// E: A resposta deve conter os dados enviados",
							"pm.test(\"✓ E: Resposta deve conter userId enviado (1)\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('userId', 1);",
							"});",
							"",
							"pm.test(\"✓ E: Resposta deve conter title enviado ('Nova ID')\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('title', 'Nova ID');",
							"});",
							"",
							"pm.test(\"✓ E: Resposta deve ter um ID gerado pelo servidor\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData.id).to.be.a('number');",
							"    pm.expect(jsonData.id).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": 1,\n    \"title\": \"Nova ID\"\n}"
				},
				"url": {
					"raw": "https://jsonplaceholder.typicode.com/albums",
					"protocol": "https",
					"host": [
						"jsonplaceholder",
						"typicode",
						"com"
					],
					"path": [
						"albums"
					]
				},
				"description": "Teste do método POST para validar a criação de um novo álbum e o status code."
			},
			"response": []
		}
	]
}
